# Environment for the vless-node systemd unit (scripts/server-vless.service).
# Install it as /etc/server-vless/env, readable by root only:
#
#   install -D -m 0600 server-vless.env.example /etc/server-vless/env
#
# systemd reads KEY=value lines here. There is no shell expansion, so write
# values literally and leave quotes off. See the README tables under "Runtime
# configuration" for the matching flags.

# Required. The unit does not start until all three are set.
API=https://panel.example.com
TOKEN=replace-with-the-server-api-token
NODE=1

# TLS certificate for nodes whose panel config uses tls=1. The unit hides
# /root, so the binary's /root/.cert defaults are unreadable there; keep the
# files under /etc/server-vless instead. The key is read only by the node and
# should stay root-only (mode 0600).
#CERT_FILE=/etc/server-vless/certs/server.crt
#KEY_FILE=/etc/server-vless/certs/server.key

# Log level: error, info or debug. The default is error.
#LOG_LEVEL=error

# API request cycles. The defaults are 60s, 80s and 60s; the check interval
# defaults to whatever FETCH_USER_INTERVAL is.
#FETCH_USER_INTERVAL=60s
#REPORT_TRAFFICS_INTERVAL=80s
#HEARTBEAT_INTERVAL=60s
#CHECK_NODE_INTERVAL=60s

# Comma-separated DNS servers, overriding the panel and default DNS.
#DNS=1.1.1.1,8.8.8.8

# Directory holding geoip.dat and geosite.dat. Unset means the binary's own
# directory, then /usr/local/share/xray, /usr/share/xray and /opt/share/xray.
#ASSET_DIR=/usr/local/share/xray

# Disable inbound sniffing. Default false.
#DISABLE_SNIFFING=false

# Let the direct egress reach private and loopback destinations.
# Security-sensitive; read the README section first. Default false.
#ALLOW_PRIVATE_OUTBOUND=false

# Freedom outbound domain strategy. Default UseIPv4v6.
#DOMAIN_STRATEGY=UseIPv4v6
